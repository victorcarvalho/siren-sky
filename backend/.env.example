# Path to the dataset directory containing images for classification
DATASET_PATH=dataset

# OpenAI API key for authentication with the GPT API (required if MODEL is an OpenAI model)
OPENAI_API_KEY=OPENAI_API_KEY

# Google Gemini API key for authentication with Gemini models (optional)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# The prompt template used to classify images via the API
CLASSIFICATION_PROMPT=Is there garbage in this image? Answer with yes or no.

# Image detail level for API calls (low, high, or auto)
IMAGE_DETAIL=auto

# Model to use for image classification. Options:
# - OpenAI models: gpt-4.1-mini, etc. (requires OPENAI_API_KEY)
# - localmodel: offline local lightweight Pillow-based grayscale heuristic model (no key required)
# - debug: offline simulated predictions based on image content hash (no key required)
MODEL=debug

# MLflow tracking server URI for experiment tracking and logging
TRACKING_URI=http://127.0.0.1:5000

# Comma-separated list of Google emails allowed to log in (leave empty to allow any user)
ALLOWED_EMAILS=ALLOWED_EMAILS_HERE

# Explicitly bypass the email whitelist (True to allow any Google user, False to restrict to whitelist)
BYPASS_EMAIL_WHITELIST=True


